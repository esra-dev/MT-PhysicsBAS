# Gradle
.gradle/
build/
*/build/

# Java / JVM build artifacts
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# Keep Gradle wrapper jar — required to run ./gradlew on CI
!gradle/wrapper/gradle-wrapper.jar

# Logs and runtime dumps
*.log
logs/
log/
*.out

# IDE/editor
.idea/
*.iml
.vscode/
.classpath
.project
.settings/

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Local env/config overrides
.env
.env.*

# Temporary files
*.tmp
*.swp
*~

# Generated experiment/runtime artifacts
.node-red-custom*/
# Node-RED userDirs are auto-created by run_full_project.ps1 on first start;
# their bootstrap content (node_modules, lib, backups) must never be committed.
# Ignoring the dirs does NOT untrack the settings/config subsets already
# committed for older labs (gitignore has no effect on tracked files).
.node-red-lab*/
benchmark/results/
benchmark/results.archive_*/
bench_step_log_*.csv
benchmark_results_*.csv
metrics_stereotypes_*.csv
# Phase 2 adapt runtime artifacts. NEVER commit these: every CI adapt job's
# artifact upload globs recovery_stereotypes_*.csv from the checkout root, and
# the aggregate step's first-copy-wins reconstruction would then prefer a
# stale committed file over the run's real result (contaminated run
# 29115969476 — 7 cells shadowed by leftovers committed in df53b71).
recovery_stereotypes_*.csv
metrics_adapted_stereotypes_*.csv
# ...but the archived post-inversion runs of record (downloaded from the CI
# runs' phase2-consolidated artifacts) ARE the citable §9.7 data — keep them
# committable like phase2_results_v6/ etc.
!phase2_postinv/**
!phase2_f2bdead/**
coverage_stereotypes_*.csv
first_goal_stereotypes_*.csv
learned_stereotypes_*.ttl
iv_stats_*.json
qtable_*.csv
# Phase-1 protocol-v2 and historical archives are permanent evidence, not
# runtime leftovers.  Keep every downloaded artifact byte committable even
# when its filename matches one of the generated-artifact patterns above.
!phase1_v2_corrected/**
!phase1_postinv/historical_raw/**
nr_custom*_*.txt
java_pid*.hprof

# Phase 3 (process dynamics) runtime artifacts — regenerated by every
# taskDynamics / run_phase3_dynamics.ps1 run (kept local like the Phase 1/2
# *_stereotypes_* artifacts above; the canonical copies live in CI artifacts
# and the published 'results' branch).
dynamics_delays_*.csv
timebounded_results_*.csv
learned_dynamics_*.ttl

# Python cache
__pycache__/
*.pyc

# Stray work-in-progress markers (do not commit)
*.TODO

# Parallel orchestrator clone tree (sibling of project root)
../*-clones/

# Analysis generated outputs
analysis/out/

# Step-0 sanity / replicability probe outputs (local-machine ephemera)
tmp_step0_*/
tmp_paper_results/
tmp_step2_validation/

# Build output resource copies
bin/

# Research papers / PDFs
*.pdf

# Local-only working notes — never committed (guards against git add -A / .)
paper_notes/_private/

# Archived post-inversion runs of record (Phases 1/3/4), downloaded from the
# CI runs' *-consolidated artifacts — the citable data, same rationale as
# !phase2_postinv/** above. These negations sit at the END of the file so they
# override every runtime-artifact pattern above (last matching rule wins).
!phase1_postinv/**
!phase3_postinv/**
!phase4_postinv/**

# attic/local_outputs: untracked local working outputs swept from the repo
# root (2026-07-19 audit D8); never commit
attic/local_outputs/

# Phase-1b pilot raw artifact trees stay local (PILOT_ONLY markers, the
# diagnostics CSV and the power inputs/report are committed explicitly).
phase1b_pilot/run_*/*/
phase1b_pilot/staged/
