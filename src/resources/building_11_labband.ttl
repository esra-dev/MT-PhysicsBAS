@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

@prefix brick:  <https://brickschema.org/schema/Brick#> .
@prefix elem:   <http://w3id.org/elementary#> .
@prefix qudt:   <http://qudt.org/schema/qudt/> .
@prefix qudtqk: <http://qudt.org/vocab/quantitykind/> .
@prefix sosa:   <http://www.w3.org/ns/sosa/> .

@prefix lab:    <http://example.org/was/lab#> .
@prefix ws:     <http://example.org/was/lab/stereotypes#> .

# ===========================================================================
#  LAB BAND — EXACT-BAND SINGLE-ZONE LAB  (Phase 1b lab, target rank 2
#  EXACTLY: the zone must sit INSIDE the 100-300 lux band, overshoot fails)
# ---------------------------------------------------------------------------
#  SELF-CONTAINED domain ontology. Loaded via ont(["building_11_labband.ttl"])
#  WITHOUT lab-ontology.ttl. One zone (Workstation 1), four actuators:
#
#     StrongLamp_Z1  +400 lux when ON        (direct proportionality, no IV)
#     WeakLamp_Z1    +150 lux when ON        (direct proportionality, no IV)
#     Blind_Z1       +0.50*Sun when open     (direct, legacy sunshine IV)
#     Awning_Z1      shades the daylight     (INVERSE proportionality,
#                    path to 25% of its      TWO IV gates: sunshine slot +
#                    unshaded value)         Z1Blinds state slot)
#
#  Phase-1b vocabulary exercised by this lab (docs/KNOWLEDGE_PROVENANCE.md):
#   - elem:directProportion / elem:inverseProportion asserted on each
#     mechanism's ManipulatedVariable individual (paper-aligned qualitative
#     direction, layer 1). NO legacy increases-shortcut anywhere in this file.
#   - ws:behavioralDescriptionComplete true on EVERY stereotype (layer-4
#     completeness marker for the three-valued relevance classification).
#   - Multi-IV gate collection on the awning: ws:awn_iv_a_sun carries NO
#     explicit slot binding (falls back to the legacy sunshine slot at the
#     mechanism's ws:ivMinRank); ws:awn_iv_b_path is bound to the Z1Blinds
#     state slot via ws:gateWoTStateSemanticType + ws:gateMinValue (the
#     awning only matters while the daylight path is open).
#     NAMING IS LOAD-BEARING: awn_iv_a_sun sorts lexicographically BEFORE
#     awn_iv_b_path, so the first enrichment row (legacy single-slot
#     binding) lands on the SUNSHINE slot.
#
#  The awning is the first INVERSE actuator in the lab roster: deploying it
#  DECREASES illuminance. Combined with the exact-band goal this creates
#  overshoot traps (strong lamp ON or unshaded high daylight both blow past
#  the 300-lux ceiling) that reward correct qualitative-direction knowledge.
#
#  This is a CLEAN lab (no weaknesses): the simulator reacts EXACTLY as the
#  KG documents.
#
#  Physics (simulator_flow_labband.json, port 1912):
#     daylight = (Z1Blinds ? 0.50 * Sun : 0)
#     if (Awning deployed) daylight *= 0.25
#     Z1Level  = 25 + (StrongLamp ? 400 : 0) + (WeakLamp ? 150 : 0) + daylight
#  Sunshine sampled once per episode from {0,100,400,900} and PINNED.
#  Rank bounds [50,100,300] (target rank 2 = 100-300 lux, EXACT band);
#  sun bounds [50,200,600].
#  State vector = [Z1Level, StrongLamp, WeakLamp, Z1Blinds, Awning, Sunshine]
#               = 4*2*2*2*2*4 = 1024 states.
# ===========================================================================


# ===========================================================================
# Property declarations (self-contained)
# ===========================================================================

brick:feeds   owl:equivalentProperty elem:feeds .
sosa:observes owl:equivalentProperty elem:observes .

# Phase 1b: paper-aligned qualitative direction, asserted MV -> DV.
elem:directProportion a owl:ObjectProperty ;
    rdfs:label "direct qualitative proportionality (MV -> DV)" .
elem:inverseProportion a owl:ObjectProperty ;
    rdfs:label "inverse qualitative proportionality (MV -> DV)" .

ws:zoneIndex a owl:DatatypeProperty ;
    rdfs:label "Zone index" ; rdfs:range xsd:integer .

ws:ivMinRank a owl:DatatypeProperty ;
    rdfs:label "Minimum effective IV rank" ; rdfs:range xsd:integer .

ws:actionValue a owl:DatatypeProperty ;
    rdfs:label "Action boolean value" ; rdfs:range xsd:boolean .

ws:rankBound_1 a owl:DatatypeProperty ; rdfs:range xsd:decimal .
ws:rankBound_2 a owl:DatatypeProperty ; rdfs:range xsd:decimal .
ws:rankBound_3 a owl:DatatypeProperty ; rdfs:range xsd:decimal .

ws:hasWoTActionSemanticType a owl:DatatypeProperty ; rdfs:range xsd:anyURI .
ws:hasWoTStateSemanticType  a owl:DatatypeProperty ; rdfs:range xsd:anyURI .
ws:stateVecIndex   a owl:DatatypeProperty ; rdfs:range xsd:integer .
ws:stateDomainSize a owl:DatatypeProperty ; rdfs:range xsd:integer .
ws:stateSlotRole   a owl:DatatypeProperty ; rdfs:range xsd:string .

# --- Phase 1b: completeness marker + multi-IV gate bindings ----------------
# ws:behavioralDescriptionComplete — layer-4 marker: the stereotype's declared
#     behavioural description is COMPLETE (open-world rule: absence yields
#     UNKNOWN relevance, never EXPLICIT_OTHER_DV).
# ws:gateWoTStateSemanticType / ws:gateMinValue — bind an IndependentVariable
#     individual to a specific deployment state slot; an IV WITHOUT this
#     binding falls back to the legacy sunshine slot at the mechanism's
#     ws:ivMinRank.
ws:behavioralDescriptionComplete a owl:DatatypeProperty ;
    rdfs:label "behavioral description declared complete" ;
    rdfs:range xsd:boolean .
ws:gateWoTStateSemanticType a owl:DatatypeProperty ;
    rdfs:label "IV gate state-slot binding (WoT state semantic type)" ;
    rdfs:range xsd:string .
ws:gateMinValue a owl:DatatypeProperty ;
    rdfs:label "minimum slot value satisfying the bound IV gate" ;
    rdfs:range xsd:integer .


# ===========================================================================
# 1.  PHYSICAL MECHANISMS
# ===========================================================================

ws:pm_strong_lamp_emission a owl:NamedIndividual, elem:PhysicalMechanism ;
    rdfs:label "pm_strong_lamp_emission (high-power incandescent, +400 lux)" ;
    elem:hasManipulatedVariable ws:strongLampPowerInput ;
    elem:hasDependentVariable   elem:luminiscence .

ws:pm_weak_lamp_emission a owl:NamedIndividual, elem:PhysicalMechanism ;
    rdfs:label "pm_weak_lamp_emission (low-power task lamp, +150 lux)" ;
    elem:hasManipulatedVariable ws:weakLampPowerInput ;
    elem:hasDependentVariable   elem:luminiscence .

ws:pm_daylight_ingress a owl:NamedIndividual, elem:PhysicalMechanism ;
    rdfs:label "pm_daylight_ingress through blind aperture" ;
    elem:hasIndependentVariable ws:outdoorIlluminance ;
    elem:hasManipulatedVariable ws:blindApertureRatio ;
    elem:hasDependentVariable   elem:luminiscence ;
    ws:ivMinRank                1 .

# Awning: INVERSE mechanism — deploying the awning REDUCES the daylight
# reaching the window (shades the ingress path to 25% of its unshaded
# value). Effective only while (a) there is sunshine (legacy sunshine-slot
# gate, ws:awn_iv_a_sun, NO explicit binding -> falls back to the sunshine
# slot at ws:ivMinRank) and (b) the daylight path is OPEN (explicitly bound
# gate ws:awn_iv_b_path -> Z1Blinds state slot >= 1). Both gates attach to
# BOTH action polarities: retracting the awning also only matters while
# sun is up and the blinds are open.
ws:pm_awning_daylight_shading a owl:NamedIndividual, elem:PhysicalMechanism ;
    rdfs:label "pm_awning_daylight_shading (external awning over the window)" ;
    elem:hasIndependentVariable ws:awn_iv_a_sun ;
    elem:hasIndependentVariable ws:awn_iv_b_path ;
    elem:hasManipulatedVariable ws:awningDeploymentRatio ;
    elem:hasDependentVariable   elem:luminiscence ;
    ws:ivMinRank                1 .

ws:illuminanceSensing a owl:NamedIndividual, elem:PhysicalMechanism ;
    rdfs:label "Illuminance sensing" ;
    elem:hasIndependentVariable elem:luminiscence ;
    elem:hasDependentVariable   ws:sensedIlluminance .

ws:pm_outdoor_light_emission a owl:NamedIndividual, elem:PhysicalMechanism ;
    rdfs:label "pm_outdoor_light_emission" ;
    elem:hasDependentVariable   ws:outdoorIlluminance .

ws:outdoorIlluminanceSensing a owl:NamedIndividual, elem:PhysicalMechanism ;
    rdfs:label "Outdoor illuminance sensing" ;
    elem:hasIndependentVariable ws:outdoorIlluminance ;
    elem:hasDependentVariable   ws:sensedOutdoorIlluminance .


# ===========================================================================
# 2.  PROCESS VARIABLES
# ===========================================================================

# --- Manipulated variables (one per actuator mechanism; each carries its ---
# --- paper-aligned qualitative direction toward the Illuminance DV)      ---

ws:strongLampPowerInput a owl:NamedIndividual, elem:ProcessVariable ;
    rdfs:label "Strong-lamp electrical power input (on/off)" ;
    elem:dealsWithStuff  elem:electrical_power ;
    elem:hasProcessPosition elem:inlet ;
    elem:hasQuantity     qudtqk:ActivePower ;
    elem:directProportion elem:luminiscence .

ws:weakLampPowerInput a owl:NamedIndividual, elem:ProcessVariable ;
    rdfs:label "Weak-lamp electrical power input (on/off)" ;
    elem:dealsWithStuff  elem:electrical_power ;
    elem:hasProcessPosition elem:inlet ;
    elem:hasQuantity     qudtqk:ActivePower ;
    elem:directProportion elem:luminiscence .

ws:blindApertureRatio a owl:NamedIndividual, elem:ProcessVariable ;
    rdfs:label "Blind aperture ratio (open vs. closed)" ;
    elem:dealsWithStuff  ws:MechanicalPosition ;
    elem:hasProcessPosition elem:inlet ;
    elem:hasQuantity     qudtqk:DimensionlessRatio ;
    elem:directProportion elem:luminiscence .

ws:awningDeploymentRatio a owl:NamedIndividual, elem:ProcessVariable ;
    rdfs:label "Awning deployment ratio (retracted vs. deployed)" ;
    elem:dealsWithStuff  ws:MechanicalPosition ;
    elem:hasProcessPosition elem:inlet ;
    elem:hasQuantity     qudtqk:DimensionlessRatio ;
    elem:inverseProportion elem:luminiscence .

# --- Independent variables --------------------------------------------------

ws:outdoorIlluminance a owl:NamedIndividual, elem:ProcessVariable ;
    rdfs:label "Outdoor illuminance (sunshine)" ;
    elem:dealsWithStuff  elem:photons ;
    elem:hasProcessPosition elem:inlet ;
    elem:hasQuantity     qudtqk:Illuminance .

# Awning IV gate A: sunshine. NO ws:gateWoTStateSemanticType binding — this
# IV deliberately exercises the LEGACY fallback (sunshine slot at the
# mechanism's ws:ivMinRank). Its URI sorts lexicographically BEFORE
# ws:awn_iv_b_path, so the first enrichment row fixes the legacy single-slot
# binding on the sunshine slot. Do NOT rename.
ws:awn_iv_a_sun a owl:NamedIndividual, elem:ProcessVariable ;
    rdfs:label "Outdoor illuminance over the awning (sunshine gate)" ;
    elem:dealsWithStuff  elem:photons ;
    elem:hasProcessPosition elem:inlet ;
    elem:hasQuantity     qudtqk:Illuminance .

# Awning IV gate B: daylight path. EXPLICITLY bound to the Z1Blinds state
# slot — the awning has an observable effect only while the blinds are open
# (slot value >= 1).
ws:awn_iv_b_path a owl:NamedIndividual, elem:ProcessVariable ;
    rdfs:label "Daylight path state (blind aperture gate)" ;
    elem:dealsWithStuff  elem:photons ;
    elem:hasProcessPosition elem:inlet ;
    elem:hasQuantity     qudtqk:DimensionlessRatio ;
    ws:gateWoTStateSemanticType "http://example.org/was#Z1Blinds" ;
    ws:gateMinValue             1 .

# --- Dependent variables ----------------------------------------------------

elem:luminiscence a owl:NamedIndividual, elem:ProcessVariable ;
    rdfs:label "Indoor illuminance level" ;
    elem:dealsWithStuff  elem:photons ;
    elem:hasProcessPosition elem:outlet ;
    elem:hasQuantity     qudtqk:Illuminance .

ws:sensedIlluminance a owl:NamedIndividual, elem:ProcessVariable ;
    rdfs:label "Sensed indoor illuminance signal" ;
    elem:dealsWithStuff  elem:photons ;
    elem:hasProcessPosition elem:outlet ;
    elem:hasQuantity     qudtqk:Illuminance ;
    ws:rankBound_1       "50"^^xsd:decimal ;
    ws:rankBound_2       "100"^^xsd:decimal ;
    ws:rankBound_3       "300"^^xsd:decimal .

ws:sensedOutdoorIlluminance a owl:NamedIndividual, elem:ProcessVariable ;
    rdfs:label "Sensed outdoor illuminance signal" ;
    elem:dealsWithStuff  elem:photons ;
    elem:hasProcessPosition elem:outlet ;
    elem:hasQuantity     qudtqk:Illuminance ;
    ws:rankBound_1       "50"^^xsd:decimal ;
    ws:rankBound_2       "200"^^xsd:decimal ;
    ws:rankBound_3       "600"^^xsd:decimal .


# ===========================================================================
# 3.  PHYSICAL STUFF + STREAM KINDS
# ===========================================================================

elem:photons a owl:NamedIndividual, elem:PhysicalStuff ;
    rdfs:label "Visible light (photons)" .

ws:MechanicalPosition a owl:NamedIndividual, elem:PhysicalStuff ;
    rdfs:label "Mechanical position / aperture" .

ws:IndoorLightingStream a owl:NamedIndividual, elem:StreamKind ;
    rdfs:label "Indoor lighting stream" .

ws:OutdoorSunlightStream a owl:NamedIndividual, elem:StreamKind ;
    rdfs:label "Outdoor sunlight stream" .


# ===========================================================================
# 4.  COMPONENT STEREOTYPES
#     (every stereotype carries ws:behavioralDescriptionComplete true)
# ===========================================================================

ws:StrongLampStereotype a owl:NamedIndividual, elem:Stereotype ;
    rdfs:label "Strong incandescent lamp stereotype (+400 lux)" ;
    elem:hasPhysicalMechanism ws:pm_strong_lamp_emission ;
    elem:hasConnectionPoint  ws:cp_stronglamp_electrical_inlet ;
    elem:hasConnectionPoint  ws:cp_stronglamp_photon_outlet ;
    ws:behavioralDescriptionComplete true .

ws:cp_stronglamp_electrical_inlet a owl:NamedIndividual, elem:InletConnectionPoint ;
    rdfs:label "Electrical inlet of strong lamp" ;
    elem:dealsWithStuff elem:electrical_power ;
    elem:manipulates    ws:strongLampPowerInput .

ws:cp_stronglamp_photon_outlet a owl:NamedIndividual, elem:OutletConnectionPoint ;
    rdfs:label "Photon (light) outlet of strong lamp" ;
    elem:dealsWithStuff        elem:photons ;
    elem:isRelatedToVariable   elem:luminiscence ;
    elem:suitableFor           ws:IndoorLightingStream .

ws:WeakLampStereotype a owl:NamedIndividual, elem:Stereotype ;
    rdfs:label "Weak task lamp stereotype (+150 lux)" ;
    elem:hasPhysicalMechanism ws:pm_weak_lamp_emission ;
    elem:hasConnectionPoint  ws:cp_weaklamp_electrical_inlet ;
    elem:hasConnectionPoint  ws:cp_weaklamp_photon_outlet ;
    ws:behavioralDescriptionComplete true .

ws:cp_weaklamp_electrical_inlet a owl:NamedIndividual, elem:InletConnectionPoint ;
    rdfs:label "Electrical inlet of weak lamp" ;
    elem:dealsWithStuff elem:electrical_power ;
    elem:manipulates    ws:weakLampPowerInput .

ws:cp_weaklamp_photon_outlet a owl:NamedIndividual, elem:OutletConnectionPoint ;
    rdfs:label "Photon (light) outlet of weak lamp" ;
    elem:dealsWithStuff        elem:photons ;
    elem:isRelatedToVariable   elem:luminiscence ;
    elem:suitableFor           ws:IndoorLightingStream .

ws:BlindStereotype a owl:NamedIndividual, elem:Stereotype ;
    rdfs:label "Window blind stereotype" ;
    elem:hasPhysicalMechanism ws:pm_daylight_ingress ;
    elem:hasConnectionPoint  ws:cp_blind_outdoor_inlet ;
    elem:hasConnectionPoint  ws:cp_blind_actuator_inlet ;
    elem:hasConnectionPoint  ws:cp_blind_light_outlet ;
    ws:behavioralDescriptionComplete true .

ws:cp_blind_outdoor_inlet a owl:NamedIndividual, elem:InletConnectionPoint ;
    rdfs:label "Outdoor sunlight inlet of blind" ;
    elem:dealsWithStuff        elem:photons ;
    elem:isRelatedToVariable   ws:outdoorIlluminance ;
    elem:suitableFor           ws:OutdoorSunlightStream .

ws:cp_blind_actuator_inlet a owl:NamedIndividual, elem:InletConnectionPoint ;
    rdfs:label "Actuator inlet of blind (Up / Down command)" ;
    elem:dealsWithStuff ws:MechanicalPosition ;
    elem:manipulates    ws:blindApertureRatio .

ws:cp_blind_light_outlet a owl:NamedIndividual, elem:OutletConnectionPoint ;
    rdfs:label "Indoor light outlet of blind" ;
    elem:dealsWithStuff        elem:photons ;
    elem:isRelatedToVariable   elem:luminiscence ;
    elem:suitableFor           ws:IndoorLightingStream .

ws:AwningStereotype a owl:NamedIndividual, elem:Stereotype ;
    rdfs:label "External awning stereotype (inverse daylight shading)" ;
    elem:hasPhysicalMechanism ws:pm_awning_daylight_shading ;
    elem:hasConnectionPoint  ws:cp_awning_outdoor_inlet ;
    elem:hasConnectionPoint  ws:cp_awning_actuator_inlet ;
    elem:hasConnectionPoint  ws:cp_awning_light_outlet ;
    ws:behavioralDescriptionComplete true .

ws:cp_awning_outdoor_inlet a owl:NamedIndividual, elem:InletConnectionPoint ;
    rdfs:label "Outdoor sunlight inlet of awning" ;
    elem:dealsWithStuff        elem:photons ;
    elem:isRelatedToVariable   ws:awn_iv_a_sun ;
    elem:suitableFor           ws:OutdoorSunlightStream .

ws:cp_awning_actuator_inlet a owl:NamedIndividual, elem:InletConnectionPoint ;
    rdfs:label "Actuator inlet of awning (Deploy / Retract command)" ;
    elem:dealsWithStuff ws:MechanicalPosition ;
    elem:manipulates    ws:awningDeploymentRatio .

ws:cp_awning_light_outlet a owl:NamedIndividual, elem:OutletConnectionPoint ;
    rdfs:label "Shaded daylight outlet of awning (toward the window)" ;
    elem:dealsWithStuff        elem:photons ;
    elem:isRelatedToVariable   elem:luminiscence ;
    elem:suitableFor           ws:IndoorLightingStream .

ws:LightSensorStereotype a owl:NamedIndividual, elem:Stereotype ;
    rdfs:label "Indoor light sensor stereotype" ;
    elem:hasPhysicalMechanism ws:illuminanceSensing ;
    elem:hasConnectionPoint  ws:cp_lightsensor_photon_inlet ;
    elem:hasConnectionPoint  ws:cp_lightsensor_signal_outlet ;
    ws:behavioralDescriptionComplete true .

ws:cp_lightsensor_photon_inlet a owl:NamedIndividual, elem:InletConnectionPoint ;
    rdfs:label "Photon inlet of indoor light sensor" ;
    elem:dealsWithStuff      elem:photons ;
    elem:isRelatedToVariable elem:luminiscence ;
    elem:suitableFor         ws:IndoorLightingStream .

ws:cp_lightsensor_signal_outlet a owl:NamedIndividual, elem:OutletConnectionPoint ;
    rdfs:label "Measurement signal outlet of indoor light sensor" ;
    elem:dealsWithStuff      elem:photons ;
    elem:isRelatedToVariable ws:sensedIlluminance .

ws:WeatherStationStereotype a owl:NamedIndividual, elem:Stereotype ;
    rdfs:label "Weather station (outdoor illuminance sensor) stereotype" ;
    elem:hasPhysicalMechanism ws:outdoorIlluminanceSensing ;
    elem:hasConnectionPoint  ws:cp_ws_photon_inlet ;
    elem:hasConnectionPoint  ws:cp_ws_signal_outlet ;
    ws:behavioralDescriptionComplete true .

ws:cp_ws_photon_inlet a owl:NamedIndividual, elem:InletConnectionPoint ;
    rdfs:label "Photon inlet of weather station" ;
    elem:dealsWithStuff      elem:photons ;
    elem:isRelatedToVariable ws:outdoorIlluminance ;
    elem:suitableFor         ws:OutdoorSunlightStream .

ws:cp_ws_signal_outlet a owl:NamedIndividual, elem:OutletConnectionPoint ;
    rdfs:label "Measurement signal outlet of weather station" ;
    elem:dealsWithStuff      elem:photons ;
    elem:isRelatedToVariable ws:sensedOutdoorIlluminance .

ws:OutsideStereotype a owl:NamedIndividual, elem:Stereotype ;
    rdfs:label "Outdoor light source (sun) stereotype" ;
    elem:hasPhysicalMechanism ws:pm_outdoor_light_emission ;
    elem:hasConnectionPoint  ws:cp_outside_light_outlet ;
    ws:behavioralDescriptionComplete true .

ws:cp_outside_light_outlet a owl:NamedIndividual, elem:OutletConnectionPoint ;
    rdfs:label "Outdoor light outlet (sun)" ;
    elem:dealsWithStuff      elem:photons ;
    elem:isRelatedToVariable ws:outdoorIlluminance ;
    elem:suitableFor         ws:OutdoorSunlightStream .


# ===========================================================================
# 5.  BUILDING TOPOLOGY (single zone)
# ===========================================================================

lab:Workstation a owl:Class ;
    rdfs:label "Workstation" ;
    rdfs:subClassOf brick:Space .

lab:BandBuilding a brick:Building ;
    rdfs:label "Lab Band (Exact-Band Single-Zone) Building" ;
    brick:hasPart lab:Lab .

lab:Lab a brick:Room ;
    rdfs:label "Lab Band room" ;
    brick:hasPart lab:Zone1 .

lab:Zone1 a lab:Workstation ;
    rdfs:label "Workstation 1" ;
    brick:isLocatedIn lab:Lab ;
    ws:zoneIndex 1 .


# ===========================================================================
# 6.  COMPONENT INSTANCES
# ===========================================================================

lab:Indoor_Illuminance_Sensor_Equipment a owl:Class ;
    rdfs:label "Indoor illuminance sensor equipment" ;
    rdfs:subClassOf brick:Sensor_Equipment .

lab:StrongLamp_Z1 a brick:Luminaire, elem:Actuator ;
    rdfs:label "Strong incandescent lamp – Workstation 1 (+400 lux)" ;
    brick:isLocatedIn lab:Zone1 ;
    elem:hasBehavioralStereotype ws:StrongLampStereotype ;
    elem:isPartOf      lab:IndoorLightingStream .

lab:WeakLamp_Z1 a brick:Luminaire, elem:Actuator ;
    rdfs:label "Weak task lamp – Workstation 1 (+150 lux)" ;
    brick:isLocatedIn lab:Zone1 ;
    elem:hasBehavioralStereotype ws:WeakLampStereotype ;
    elem:isPartOf      lab:IndoorLightingStream .

lab:Blind_Z1 a brick:Blind, elem:Actuator ;
    rdfs:label "Window blind – Workstation 1" ;
    brick:isLocatedIn lab:Zone1 ;
    elem:hasBehavioralStereotype ws:BlindStereotype ;
    elem:isPartOf      lab:IndoorLightingStream ;
    elem:isPartOf      lab:OutdoorSunlightStream .

lab:Awning_Z1 a brick:Equipment, elem:Actuator ;
    rdfs:label "External awning – Workstation 1 (shades the window daylight path)" ;
    brick:isLocatedIn lab:Zone1 ;
    elem:hasBehavioralStereotype ws:AwningStereotype ;
    elem:isPartOf      lab:IndoorLightingStream ;
    elem:isPartOf      lab:OutdoorSunlightStream .

lab:LightSensor_Z1 a lab:Indoor_Illuminance_Sensor_Equipment, elem:Sensor ;
    rdfs:label "Indoor illuminance sensor – Workstation 1" ;
    brick:isLocatedIn lab:Zone1 ;
    sosa:observes     lab:IndoorIlluminance_Z1 ;
    elem:hasBehavioralStereotype ws:LightSensorStereotype ;
    elem:isPartOf      lab:IndoorLightingStream .

lab:WeatherStation a brick:Weather_Station, elem:Sensor ;
    rdfs:label "Outdoor weather station" ;
    brick:isLocatedIn lab:BandBuilding ;
    sosa:observes     lab:OutdoorIlluminance ;
    elem:hasBehavioralStereotype ws:WeatherStationStereotype ;
    elem:isPartOf      lab:OutdoorSunlightStream .

lab:Outside a owl:NamedIndividual ;
    rdfs:label "Outdoor light source (sun)" ;
    elem:hasBehavioralStereotype ws:OutsideStereotype ;
    elem:isPartOf      lab:OutdoorSunlightStream .

lab:IndoorLightingStream a elem:Stream ;
    rdfs:label "Indoor lighting process stream" ;
    elem:hasStreamKind ws:IndoorLightingStream .

lab:OutdoorSunlightStream a elem:Stream ;
    rdfs:label "Outdoor sunlight stream" ;
    elem:hasStreamKind ws:OutdoorSunlightStream .

lab:IndoorIlluminance_Z1 a sosa:ObservableProperty ;
    rdfs:label "Indoor illuminance – Workstation 1" ;
    qudt:hasQuantityKind qudtqk:Illuminance .

lab:OutdoorIlluminance a sosa:ObservableProperty ;
    rdfs:label "Outdoor illuminance (sunshine)" ;
    qudt:hasQuantityKind qudtqk:Illuminance .


# ===========================================================================
# 7.  TOPOLOGICAL CONNECTIONS (single zone — no cross-zone arcs)
# ===========================================================================

# Sun -> weather station + daylight-path components.
lab:Outside          brick:feeds  lab:WeatherStation .
lab:Outside          brick:feeds  lab:Awning_Z1 .
lab:Awning_Z1        brick:feeds  lab:Blind_Z1 .

# Primary illumination (same zone).
lab:StrongLamp_Z1    brick:feeds  lab:LightSensor_Z1 .
lab:WeakLamp_Z1      brick:feeds  lab:LightSensor_Z1 .
lab:Blind_Z1         brick:feeds  lab:LightSensor_Z1 .


# ===========================================================================
# 8.  COMPONENT ACTIONS
# ===========================================================================

ws:SetStrongLamp_ON  a elem:ComponentAction ; ws:actionValue "true"^^xsd:boolean .
ws:SetStrongLamp_OFF a elem:ComponentAction ; ws:actionValue "false"^^xsd:boolean .
lab:StrongLamp_Z1 elem:hasComponentAction ws:SetStrongLamp_ON, ws:SetStrongLamp_OFF .

ws:SetWeakLamp_ON  a elem:ComponentAction ; ws:actionValue "true"^^xsd:boolean .
ws:SetWeakLamp_OFF a elem:ComponentAction ; ws:actionValue "false"^^xsd:boolean .
lab:WeakLamp_Z1 elem:hasComponentAction ws:SetWeakLamp_ON, ws:SetWeakLamp_OFF .

ws:SetZ1Blinds_ON  a elem:ComponentAction ; ws:actionValue "true"^^xsd:boolean .
ws:SetZ1Blinds_OFF a elem:ComponentAction ; ws:actionValue "false"^^xsd:boolean .
lab:Blind_Z1 elem:hasComponentAction ws:SetZ1Blinds_ON, ws:SetZ1Blinds_OFF .

ws:SetAwning_ON  a elem:ComponentAction ; ws:actionValue "true"^^xsd:boolean .
ws:SetAwning_OFF a elem:ComponentAction ; ws:actionValue "false"^^xsd:boolean .
lab:Awning_Z1 elem:hasComponentAction ws:SetAwning_ON, ws:SetAwning_OFF .


# ===========================================================================
# 9.  STATE VECTOR SLOT REGISTRY  (length 6)
#  [Z1Level, StrongLamp, WeakLamp, Z1Blinds, Awning, Sunshine]
# ===========================================================================

lab:Slot_ZoneLevel_Z1
    ws:stateVecIndex   0 ; ws:stateDomainSize 4 ; ws:stateSlotRole "zone_level" ; ws:zoneIndex 1 .

lab:Slot_Sunshine
    ws:stateVecIndex   5 ; ws:stateDomainSize 4 ; ws:stateSlotRole "sunshine" .


# ===========================================================================
# 10.  WoT ACTION / STATE MAPPINGS  (the discovery gate)
# ===========================================================================

lab:StrongLamp_Z1
    ws:hasWoTActionSemanticType "http://example.org/was#SetStrongLamp" ;
    ws:hasWoTStateSemanticType  "http://example.org/was#StrongLamp" ;
    ws:stateVecIndex            1 ; ws:stateDomainSize 2 ; ws:stateSlotRole "boolean_actuator" .

lab:WeakLamp_Z1
    ws:hasWoTActionSemanticType "http://example.org/was#SetWeakLamp" ;
    ws:hasWoTStateSemanticType  "http://example.org/was#WeakLamp" ;
    ws:stateVecIndex            2 ; ws:stateDomainSize 2 ; ws:stateSlotRole "boolean_actuator" .

lab:Blind_Z1
    ws:hasWoTActionSemanticType "http://example.org/was#SetZ1Blinds" ;
    ws:hasWoTStateSemanticType  "http://example.org/was#Z1Blinds" ;
    ws:stateVecIndex            3 ; ws:stateDomainSize 2 ; ws:stateSlotRole "boolean_actuator" .

lab:Awning_Z1
    ws:hasWoTActionSemanticType "http://example.org/was#SetAwning" ;
    ws:hasWoTStateSemanticType  "http://example.org/was#Awning" ;
    ws:stateVecIndex            4 ; ws:stateDomainSize 2 ; ws:stateSlotRole "boolean_actuator" .
