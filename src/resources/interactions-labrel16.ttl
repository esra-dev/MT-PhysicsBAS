          td:name "Control Ionizer" ;
          dct:title "Turn on and off the ionizer in Z1 (no effect on illuminance)" ;
          td:hasForm [
              htv:methodName "POST" ;
              hctl:hasTarget <http://localhost:1907/was/rl/action> ;
              hctl:forContentType "application/json" ;
              hctl:hasOperationType td:invokeAction
          ] ;
          td:hasInputSchema [ a js:ObjectSchema ;
              js:properties [ a js:BooleanSchema ; js:propertyName "Ionizer" ]
          ]
        ],
        [ a td:ActionAffordance, <http://example.org/was#SetCO2Scrubber> ;
          td:name "Control CO2 scrubber" ;
          dct:title "Turn on and off the co2 scrubber in Z1 (no effect on illuminance)" ;
          td:hasForm [
