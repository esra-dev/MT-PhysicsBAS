@prefix td:     <https://www.w3.org/2019/wot/td#> .
@prefix hctl:   <https://www.w3.org/2019/wot/hypermedia#> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix eve:    <http://w3id.org/eve#> .
@prefix wotsec: <https://www.w3.org/2019/wot/security#> .
@prefix js:     <https://www.w3.org/2019/wot/json-schema#> .
@prefix htv:    <http://www.w3.org/2011/http#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

# ============================================================================
#  LABREL16 — RELEVANCE LADDER Thing Description (port 1907).
#  One zone; the incandescent lamp is the ONLY light-affecting actuator:
#      Z1Level = 25 + (Z1Light ? 400 : 0)
#  Sunshine is degenerate (always 0) and exposed only for pipeline
#  compatibility. 16 decoy actuators with real WoT actions.
#  Decoy flags appear in Status for ENERGY ACCOUNTING ONLY — the KG gives
#  decoys no WoT state semantic type and no state-vector slot, so the
#  discovered state stays [Z1Level,Z1Light] (8 states).
#  Deterministic physics (no PRNG term).
# ============================================================================

<urn:mt-esra:interactions-labrel16> a td:Thing, eve:Artifact, <https://example.org/was#Lab> ;

    td:title "The lab of the Interactions team – Relevance Ladder labrel16" ;
    td:hasSecurityConfiguration [ a wotsec:NoSecurityScheme ] ;
    td:hasBase <http://localhost:1907/was/rl/> ;

    td:hasPropertyAffordance [
        a td:PropertyAffordance, <https://example.org/was#Status>, js:ObjectSchema ;
        td:name "Status" ;
        dct:title "Read the lab status" ;
        td:hasForm [
            htv:methodName "GET" ;
            hctl:hasTarget <http://localhost:1907/was/rl/status> ;
            hctl:forContentType "application/json" ;
            hctl:hasOperationType td:readProperty
        ] ;
        td:isObservable false ;
        js:properties
            [ a js:NumberSchema, <http://example.org/was#Z1Level> ;
              js:propertyName "Z1Level" ],
            [ a js:BooleanSchema, <http://example.org/was#Z1Light> ;
              js:propertyName "Z1Light" ],
            [ a js:BooleanSchema, <http://example.org/was#Fan> ;
              js:propertyName "Fan" ],
            [ a js:BooleanSchema, <http://example.org/was#Humidifier> ;
              js:propertyName "Humidifier" ],
            [ a js:BooleanSchema, <http://example.org/was#Heater> ;
              js:propertyName "Heater" ],
            [ a js:BooleanSchema, <http://example.org/was#Speaker> ;
              js:propertyName "Speaker" ],
            [ a js:BooleanSchema, <http://example.org/was#AirPurifier> ;
              js:propertyName "AirPurifier" ],
            [ a js:BooleanSchema, <http://example.org/was#Dehumidifier> ;
              js:propertyName "Dehumidifier" ],
            [ a js:BooleanSchema, <http://example.org/was#Cooler> ;
              js:propertyName "Cooler" ],
            [ a js:BooleanSchema, <http://example.org/was#WhiteNoiseUnit> ;
              js:propertyName "WhiteNoiseUnit" ],
            [ a js:BooleanSchema, <http://example.org/was#Ventilator> ;
              js:propertyName "Ventilator" ],
            [ a js:BooleanSchema, <http://example.org/was#Ionizer> ;
              js:propertyName "Ionizer" ],
            [ a js:BooleanSchema, <http://example.org/was#CO2Scrubber> ;
              js:propertyName "CO2Scrubber" ],
            [ a js:BooleanSchema, <http://example.org/was#Radiator> ;
              js:propertyName "Radiator" ],
            [ a js:BooleanSchema, <http://example.org/was#ExhaustFan> ;
              js:propertyName "ExhaustFan" ],
            [ a js:BooleanSchema, <http://example.org/was#AromaDiffuser> ;
              js:propertyName "AromaDiffuser" ],
            [ a js:BooleanSchema, <http://example.org/was#Subwoofer> ;
              js:propertyName "Subwoofer" ],
            [ a js:BooleanSchema, <http://example.org/was#HeatPump> ;
              js:propertyName "HeatPump" ],
            [ a js:NumberSchema, <http://example.org/was#Sunshine> ;
              js:propertyName "Sunshine" ],
            [ a js:NumberSchema, <http://example.org/was#EnergyCost> ;
              js:propertyName "EnergyCost" ],
            [ a js:NumberSchema, <http://example.org/was#TotalEnergyCost> ;
              js:propertyName "TotalEnergyCost" ],
            [ a js:NumberSchema, <http://example.org/was#Hour> ;
              js:propertyName "Hour" ]
    ] ;

    td:hasActionAffordance
        [ a td:ActionAffordance, <http://example.org/was#SetZ1Light> ;
          td:name "Control Lights Z1" ;
          dct:title "Turn on and off the lights in Z1 (the only light-affecting actuator)" ;
          td:hasForm [
              htv:methodName "POST" ;
              hctl:hasTarget <http://localhost:1907/was/rl/action> ;
              hctl:forContentType "application/json" ;
              hctl:hasOperationType td:invokeAction
          ] ;
          td:hasInputSchema [ a js:ObjectSchema ;
              js:properties [ a js:BooleanSchema ; js:propertyName "Z1Light" ]
          ]
        ],
        [ a td:ActionAffordance, <http://example.org/was#SetFan> ;
          td:name "Control Fan" ;
          dct:title "Turn on and off the fan in Z1 (no effect on illuminance)" ;
          td:hasForm [
              htv:methodName "POST" ;
              hctl:hasTarget <http://localhost:1907/was/rl/action> ;
              hctl:forContentType "application/json" ;
              hctl:hasOperationType td:invokeAction
          ] ;
          td:hasInputSchema [ a js:ObjectSchema ;
              js:properties [ a js:BooleanSchema ; js:propertyName "Fan" ]
          ]
        ],
        [ a td:ActionAffordance, <http://example.org/was#SetHumidifier> ;
          td:name "Control Humidifier" ;
          dct:title "Turn on and off the humidifier in Z1 (no effect on illuminance)" ;
          td:hasForm [
              htv:methodName "POST" ;
              hctl:hasTarget <http://localhost:1907/was/rl/action> ;
              hctl:forContentType "application/json" ;
              hctl:hasOperationType td:invokeAction
          ] ;
          td:hasInputSchema [ a js:ObjectSchema ;
              js:properties [ a js:BooleanSchema ; js:propertyName "Humidifier" ]
          ]
        ],
        [ a td:ActionAffordance, <http://example.org/was#SetHeater> ;
          td:name "Control Heater" ;
          dct:title "Turn on and off the heater in Z1 (no effect on illuminance)" ;
          td:hasForm [
              htv:methodName "POST" ;
              hctl:hasTarget <http://localhost:1907/was/rl/action> ;
              hctl:forContentType "application/json" ;
              hctl:hasOperationType td:invokeAction
          ] ;
          td:hasInputSchema [ a js:ObjectSchema ;
              js:properties [ a js:BooleanSchema ; js:propertyName "Heater" ]
          ]
        ],
        [ a td:ActionAffordance, <http://example.org/was#SetSpeaker> ;
          td:name "Control Speaker" ;
          dct:title "Turn on and off the speaker in Z1 (no effect on illuminance)" ;
          td:hasForm [
              htv:methodName "POST" ;
              hctl:hasTarget <http://localhost:1907/was/rl/action> ;
              hctl:forContentType "application/json" ;
              hctl:hasOperationType td:invokeAction
          ] ;
          td:hasInputSchema [ a js:ObjectSchema ;
              js:properties [ a js:BooleanSchema ; js:propertyName "Speaker" ]
          ]
        ],
        [ a td:ActionAffordance, <http://example.org/was#SetAirPurifier> ;
          td:name "Control Air purifier" ;
          dct:title "Turn on and off the air purifier in Z1 (no effect on illuminance)" ;
          td:hasForm [
              htv:methodName "POST" ;
              hctl:hasTarget <http://localhost:1907/was/rl/action> ;
              hctl:forContentType "application/json" ;
              hctl:hasOperationType td:invokeAction
          ] ;
          td:hasInputSchema [ a js:ObjectSchema ;
              js:properties [ a js:BooleanSchema ; js:propertyName "AirPurifier" ]
          ]
        ],
        [ a td:ActionAffordance, <http://example.org/was#SetDehumidifier> ;
          td:name "Control Dehumidifier" ;
          dct:title "Turn on and off the dehumidifier in Z1 (no effect on illuminance)" ;
          td:hasForm [
              htv:methodName "POST" ;
