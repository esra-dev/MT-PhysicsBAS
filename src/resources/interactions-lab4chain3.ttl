@prefix td:     <https://www.w3.org/2019/wot/td#> .
@prefix hctl:   <https://www.w3.org/2019/wot/hypermedia#> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix eve:    <http://w3id.org/eve#> .
@prefix wotsec: <https://www.w3.org/2019/wot/security#> .
@prefix js:     <https://www.w3.org/2019/wot/json-schema#> .
@prefix htv:    <http://www.w3.org/2011/http#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

# ============================================================================
#  LAB 4-CHAIN-3 — DEPTH-3 POWER DEPENDENCY Thing Description (port 1913).
#  Forked from Lab 4-Chain. ONE workstation, no blinds, no spotlight, no
#  sunshine effect (the Sunshine status field is pinned to 0 for pipeline
#  compatibility). The Z1 ceiling lamp is wired through a smart plug (PlugZ1)
#  which hangs off a circuit breaker (Breaker); the lamp only emits light when
#  Z1Light AND PlugZ1 AND Breaker are ALL ON. Two decoy actuators (AuxA, AuxB)
#  are observable and actionable but physically inert. Status carries the zone
#  level and all five actuator states. Deterministic physics (no PRNG term).
# ============================================================================

<urn:mt-esra:interactions-lab4chain3> a td:Thing, eve:Artifact, <https://example.org/was#Lab> ;

    td:title "The lab of the Interactions team – Lab 4-Chain-3 Depth-3 Power Dependency" ;
    td:hasSecurityConfiguration [ a wotsec:NoSecurityScheme ] ;
    td:hasBase <http://localhost:1913/was/rl/> ;

    td:hasPropertyAffordance [
        a td:PropertyAffordance, <https://example.org/was#Status>, js:ObjectSchema ;
        td:name "Status" ;
        dct:title "Read the lab status" ;
        td:hasForm [
            htv:methodName "GET" ;
            hctl:hasTarget <http://localhost:1913/was/rl/status> ;
            hctl:forContentType "application/json" ;
            hctl:hasOperationType td:readProperty
        ] ;
        td:isObservable false ;
        js:properties
            [ a js:NumberSchema, <http://example.org/was#Z1Level> ;
              js:propertyName "Z1Level" ],
            [ a js:BooleanSchema, <http://example.org/was#Z1Light> ;
              js:propertyName "Z1Light" ],
            [ a js:BooleanSchema, <http://example.org/was#PlugZ1> ;
              js:propertyName "PlugZ1" ],
            [ a js:BooleanSchema, <http://example.org/was#Breaker> ;
              js:propertyName "Breaker" ],
            [ a js:BooleanSchema, <http://example.org/was#AuxA> ;
              js:propertyName "AuxA" ],
            [ a js:BooleanSchema, <http://example.org/was#AuxB> ;
              js:propertyName "AuxB" ],
            [ a js:NumberSchema, <http://example.org/was#Sunshine> ;
              js:propertyName "Sunshine" ],
            [ a js:NumberSchema, <http://example.org/was#EnergyCost> ;
              js:propertyName "EnergyCost" ],
            [ a js:NumberSchema, <http://example.org/was#TotalEnergyCost> ;
              js:propertyName "TotalEnergyCost" ],
            [ a js:NumberSchema, <http://example.org/was#Hour> ;
              js:propertyName "Hour" ]
    ] ;

    td:hasActionAffordance
        [ a td:ActionAffordance, <http://example.org/was#SetZ1Light> ;
          td:name "Control Lights Z1" ;
          dct:title "Turn on and off the lights in Z1 (only emits light if PlugZ1 AND Breaker are also ON)" ;
          td:hasForm [
              htv:methodName "POST" ;
              hctl:hasTarget <http://localhost:1913/was/rl/action> ;
              hctl:forContentType "application/json" ;
              hctl:hasOperationType td:invokeAction
          ] ;
          td:hasInputSchema [ a js:ObjectSchema ;
              js:properties [ a js:BooleanSchema ; js:propertyName "Z1Light" ]
          ]
        ],
        [ a td:ActionAffordance, <http://example.org/was#SetPlugZ1> ;
          td:name "Control Smart Plug Z1" ;
          dct:title "Toggle the smart plug that powers the Z1 ceiling lamp (dead while Breaker is OFF)" ;
          td:hasForm [
              htv:methodName "POST" ;
              hctl:hasTarget <http://localhost:1913/was/rl/action> ;
              hctl:forContentType "application/json" ;
              hctl:hasOperationType td:invokeAction
          ] ;
          td:hasInputSchema [ a js:ObjectSchema ;
              js:properties [ a js:BooleanSchema ; js:propertyName "PlugZ1" ]
          ]
        ],
        [ a td:ActionAffordance, <http://example.org/was#SetBreaker> ;
          td:name "Control Breaker" ;
          dct:title "Toggle the circuit breaker that feeds the Z1 smart-plug circuit" ;
          td:hasForm [
              htv:methodName "POST" ;
              hctl:hasTarget <http://localhost:1913/was/rl/action> ;
              hctl:forContentType "application/json" ;
              hctl:hasOperationType td:invokeAction
          ] ;
          td:hasInputSchema [ a js:ObjectSchema ;
              js:properties [ a js:BooleanSchema ; js:propertyName "Breaker" ]
          ]
        ],
        [ a td:ActionAffordance, <http://example.org/was#SetAuxA> ;
          td:name "Control Auxiliary Unit A" ;
          dct:title "Toggle auxiliary unit A" ;
          td:hasForm [
              htv:methodName "POST" ;
              hctl:hasTarget <http://localhost:1913/was/rl/action> ;
              hctl:forContentType "application/json" ;
              hctl:hasOperationType td:invokeAction
          ] ;
          td:hasInputSchema [ a js:ObjectSchema ;
              js:properties [ a js:BooleanSchema ; js:propertyName "AuxA" ]
          ]
        ],
        [ a td:ActionAffordance, <http://example.org/was#SetAuxB> ;
          td:name "Control Auxiliary Unit B" ;
          dct:title "Toggle auxiliary unit B" ;
          td:hasForm [
              htv:methodName "POST" ;
              hctl:hasTarget <http://localhost:1913/was/rl/action> ;
              hctl:forContentType "application/json" ;
              hctl:hasOperationType td:invokeAction
          ] ;
          td:hasInputSchema [ a js:ObjectSchema ;
              js:properties [ a js:BooleanSchema ; js:propertyName "AuxB" ]
          ]
        ] .
