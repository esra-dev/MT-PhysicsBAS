    },
    "parent_files": "Resolve every basename in ADAPT_OK.parent_qtable_files uniquely among direct clean-job children for the same seed and arm, preserve manifest array order, and recompute the runner file-set digest. Do not infer a five-file set and do not recurse into benchmark/results."
  },
  "qgap_definition": {
    "name": "start-state Q-gap proxy",
    "excluded_names": ["exact post-detection burden", "recovery mechanism measurement"],
    "unavailable_actions": "F_c is the explicit unavailable_actions list for the cell.",
    "survivor_first_actions": "R_c(s) is the exact union of first actions on every shortest successful path under faulty physics with all F_c actions removed.",
    "signed_gap": "max(Q(s,x) for x in F_c) - max(Q(s,x) for x in R_c(s))",
    "burden": "max(0, signed_gap)",
    "scenario_classes": {
      "goal_at_settled_start": "NO_RERANKING_NEEDED; report and exclude from gap aggregates",
      "no_surviving_goal_path": "UNREACHABLE; report and exclude from gap aggregates",
      "reachable_nonterminal": "ANALYZED; include once with equal weight by ordered scenario ID"
    },
    "seed_arm_aggregates": {
      "G": "arithmetic mean of burden across ANALYZED scenarios",
